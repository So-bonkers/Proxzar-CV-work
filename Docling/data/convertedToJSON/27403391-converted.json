                {
                    "contentType": "list_item",
                    "source": "\uf076 Raw data Extraction, data cleansing, validation of data and Data reformat using Excel as per the client's specification."
                },
                {
                    "contentType": "list_item",
                    "source": "\uf076 Created SQL datasets and Descriptive Statistics analysis by using Python."
                },
                {
                    "contentType": "list_item",
                    "source": "\uf076 Cluster Analysis for grouping the shop type (Market Segmentation) which gives similar characteristics."
                },
                {
                    "contentType": "list_item",
                    "source": "\uf076 Expertise in Analyzing and giving insights into the client's queries by using statistical procedures like Means, Univariate, etc."
                },
                {
                    "contentType": "list_item",
                    "source": "\uf076 Providing insights using retail sales data from the previous and current periods to determine the patterns and trends."
                },
                {
                    "contentType": "list_item",
                    "source": "\uf076 Data management activities like merging, appending datasets, handling missing values reading raw data files, handling programming errors, and accessing and managing data."
                },
                {
                    "contentType": "list_item",
                    "source": "\uf076 Providing weekly and monthly reports as per the client's requirement."
                },
                {
                    "contentType": "list_item",
                    "source": "\uf076 Classifying variables into different segments basis various customer variables like: - Wallet size, website visit frequency, time spent on the website, Product views, etc."
                },
                {
                    "contentType": "list_item",
                    "source": "\uf076 Coming up with meaningful customer segments that were given to CRM and social channels like Facebook and LinkedIn for targeting them with relevant offers and increase the revenue per customer"
                },
                {
                    "contentType": "list_item",
                    "source": "\uf076 Identifying customer basis parameters like: - last transaction date, number of returned orders, number of calls, etc., that have the highest probability of not returning to the website in the next 90 days."
                }
